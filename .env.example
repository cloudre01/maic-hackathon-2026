# Copy to .env next to compose.yaml on the deployment host. Never commit .env.
# Docker Compose reads this file automatically for ${...} interpolation.

# Origins allowed to make writes, comma separated.
ARUS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Shared secret the frontend proxy presents as a bearer token.
# Generate with: openssl rand -hex 32
# The same value goes in the Vercel environment variable ARUS_API_TOKEN.
ARUS_API_TOKEN=
